[node name="Body" type="Label" parent="RulesPanel/SafeArea/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 19
theme_override_constants/line_spacing = 6
text = "Each round, you and the Crab both roll 3 dice.
Whoever rolls the stronger hand wins the round and damages the other.

HAND STRENGTH (weakest → strongest)
💀 WASHED OUT (1•2•3) — weakest, auto-loses.
🎯 PAIR + POINT — a matching pair plus an odd die. Higher pair wins; ties break on the odd die.
🎲 TRIPLE — three matching dice. Higher triple wins.
🌊 TIDAL ROLL (4•5•6) — strongest possible hand.
No-point rolls (no pair, triple, or tidal) automatically reroll.

⚔️ HOW DAMAGE WORKS
🌊 TIDAL / AUTOMATIC WIN — Deals 3 HP. (Rolling Tidal, or your opponent Washing Out, is an automatic win.)
🎲 TRIPLES — Deals 2 HP.
🎯 PAIR + POINT — Deals 1 HP.
🤝 TIE — No damage. Roll again.

Reduce your opponent to 0 HP to win the battle.

🎒 ITEMS
Items can change the outcome of combat — use one from the ITEM menu:
🐢 Turtle Shield — turns a defeat into a draw.
🔱 Trident — +2 damage on your next successful hit.
🧜 Mermaid Scale — restore 2 HP."
horizontal_alignment = 1
autowrap_mode = 2

